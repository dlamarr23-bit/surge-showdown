{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "surge-showdown",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "GameRoom" },
      { "name": "LIB", "class_name": "Library" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Library"] }
  ],
  "observability": { "enabled": true }
}
